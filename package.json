{
  "name": "coride",
  "private": true,
  "version": "0.1.0",
  "description": "CoRide monorepo workspace root (pnpm workspaces). Application packages live in subdirectories, e.g. backend/.",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm --filter backend build",
    "start": "pnpm --filter backend start",
    "dev": "pnpm --filter backend dev",
    "typecheck": "pnpm --filter backend typecheck",
    "test": "pnpm --filter backend test"
  }
}
