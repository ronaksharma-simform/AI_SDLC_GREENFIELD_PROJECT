{
  "name": "coride",
  "private": true,
  "version": "0.1.0",
  "description": "CoRide ride-sharing platform (Next.js App Router + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "start": "NODE_ENV=production next start -H 0.0.0.0 -p 3100",
    "build": "NODE_ENV=production next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "^15.3.0",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.14.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.8.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
