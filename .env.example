# CoRide environment configuration (copy to .env).
#
# DATABASE_URL is required. The two feed-tuning variables below are optional;
# when unset the discovery feed uses the built-in defaults (500 m / ±30 min).

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/coride"

# Optional — Ride Feed tuning (Part B, REQ-7).
# Default proximity radius in meters applied when a Seeker supplies a pickup
# point but no explicit radius. Defaults to 500 when unset.
# FEED_DEFAULT_RADIUS_METERS="500"

# Optional — departure-time tolerance in minutes applied when a Seeker supplies
# a desired time but no explicit window. Defaults to 30 when unset.
# FEED_DEFAULT_TIME_WINDOW_MINUTES="30"
