# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coride?schema=public"

# Secret used by NextAuth to sign/encrypt tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

# Base URL of the application, used by NextAuth for callbacks
NEXTAUTH_URL="http://localhost:3000"
