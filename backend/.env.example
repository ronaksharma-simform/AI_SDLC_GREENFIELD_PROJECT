# Copy this file to .env and fill in real values before starting the app:
#   cp backend/.env.example backend/.env
#
# backend/src/config.ts validates these at startup and will exit with an
# instructive error naming exactly which variable is missing or invalid.

# PostgreSQL connection string (standard local Postgres port is 5432).
# Required — no default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coride

# Port the Express server listens on.
# Optional — defaults to 3000 if unset.
PORT=3000

# Minimum log level for Pino structured logging.
# Required — must be one of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
